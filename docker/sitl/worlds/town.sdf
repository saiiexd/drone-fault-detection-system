<?xml version="1.0" encoding="UTF-8"?>
<!--
  aeropulse "town" world: PX4's default world (same physics, gravity,
  magnetic field and location) plus scenery, so a flight can be watched in
  a recognisable setting. Used only for the live demo (scenarios.py --world
  town); the training flights were recorded in the default world.

  The drone takes off at the origin and its scripted flights stay within
  about 35 m of it, so all scenery is at least 45 m away. Models come from
  Gazebo Fuel (OpenRobotics, CC0) and are downloaded into the image at
  build time, so the world loads offline.
-->
<sdf version="1.9">
  <world name="town">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.62 0.78 0.95 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.4 0.3 -0.85</direction>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>1 1</size></plane></geometry>
        </collision>
        <visual name="grass">
          <geometry><plane><normal>0 0 1</normal><size>600 600</size></plane></geometry>
          <material><ambient>0.30 0.45 0.20 1</ambient><diffuse>0.30 0.45 0.20 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
      <visual name="main_street">
        <pose>70 0 0.02 0 0 0</pose>
        <geometry><box><size>12 260 0.02</size></box></geometry>
        <material><ambient>0.22 0.22 0.22 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="cross_street">
        <pose>0 -100 0.02 0 0 0</pose>
        <geometry><box><size>260 10 0.02</size></box></geometry>
        <material><ambient>0.22 0.22 0.22 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="drive">
        <pose>35 0 0.02 0 0 0</pose>
        <geometry><box><size>70 6 0.02</size></box></geometry>
        <material><ambient>0.22 0.22 0.22 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      </link>
    </model>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Apartment</uri>
      <name>east_0</name>
      <pose>92.0 -75.0 0.00 0 0 1.571</pose>
    </include>
